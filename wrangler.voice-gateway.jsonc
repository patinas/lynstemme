{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lynstemme-voice-gateway",
  "main": "src/voice-gateway.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": { "bindings": [{ "class_name": "LynStemmeAgent", "name": "LynStemmeAgent" }] },
  "migrations": [{ "new_sqlite_classes": ["LynStemmeAgent"], "tag": "v1" }],
  "vars": { "AI_BACKEND": "auto" },
  "observability": { "enabled": true }
}
